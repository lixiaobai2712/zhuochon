{
  "name": "desktop-pet",
  "version": "0.1.0",
  "private": true,
  "description": "Windows 桌面宠物，支持 Codex 桌面端 / Claude Code 命令行活动检测",
  "main": "dist-electron/main.js",
  "author": "you",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dist": "npm run build && electron-builder --win nsis portable",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "gen:icon": "node scripts/gen-icon.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-electron": "^0.28.8"
  },
  "build": {
    "appId": "com.local.desktopPet",
    "productName": "桌面小宠",
    "directories": {
      "output": "../release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "resources/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../图片",
        "to": "图片"
      },
      {
        "from": "../角色",
        "to": "角色",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
